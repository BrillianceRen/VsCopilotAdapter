# AI Provider: aistudio_gemini (default), or future providers
AI_PROVIDER=aistudio_gemini

# Google Gemini API Key from Google AI Studio (for aistudio_gemini provider)
# Copy this file to .env and fill in your actual API key
GEMINI_API_KEY=your_gemini_api_key_here

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Default model used when client requests an alias or unspecified model
DEFAULT_MODEL=gemini-3.8-flash

# Thinking budget for Gemini 2.5/3.x models (0 = disabled for low latency in Copilot)
GEMINI_THINKING_BUDGET=0

# Network timeout (seconds) and automatic retries for upstream Gemini API
GEMINI_TIMEOUT=180
GEMINI_MAX_RETRIES=3

# Log level: INFO (default: concise URL/model/status only), DEBUG (full request/response body), WARNING, ERROR
LOG_LEVEL=INFO

# Log storage directory (daily log files: yyyy-MM-dd.##.log, max 30MB per file)
LOG_DIR=logs

# Maximum log file size in MB before sequence increment (default: 30)
MAX_LOG_SIZE_MB=30

# ================================================================
# Virtual Model & Fallback Degradation Strategy
# ================================================================
# Virtual model identifier exposed to clients (e.g. auto)
VIRTUAL_MODEL_NAME=auto

# Comma-separated list of models to try in sequence for the virtual model
FALLBACK_MODELS=gemini-4-hydrogen,gemini-3.8-flash

# Consecutive failure threshold before degrading to the next model in a conversation
FALLBACK_THRESHOLD=1
